# The friends' tunnel: sshd and nothing else (O18, IP22-a, RR1 H4).
#
# The game port is never exposed. A friend reaches the owner's server only by
# SSH into this container, with a key, and may forward to exactly two
# loopback ports: the friends' listener 127.0.0.1:26001 and its chat
# 127.0.0.1:5223. The sshd_config is generated by tools/tunnel.sh (never baked
# in here) so tools/test_tunnel_config.py can check every directive.
#
# Build and run only through tools/tunnel.sh:
#   tools/tunnel.sh up        # builds this image, then runs it --network host
#
# sshd runs as one unprivileged user, `eve`, whose uid and gid are the
# owner's (build args): a non-root sshd can only log in the user it runs as,
# which is exactly the "one forced user" the row asks for, and it needs no
# capability at all (the container drops them all). The owner's uid also
# lets it read the key files tools/tunnel.sh writes under var/tunnel/ with
# StrictModes on.
#
# The base image is pinned by digest: alpine:3.20, the one already on the
# build machine (`docker image inspect alpine:3.20`, RepoDigests). Bump it
# deliberately. openssh-server comes from Alpine's signed apk archive.
FROM alpine@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc

ARG UID=1000
ARG GID=1000

# The account: no home, shell /bin/false, password field "*" (no password can
# ever match it; "!" would make sshd call the account locked and refuse keys
# too). Then remove what sshd does not need: the stock config and the
# package's own host keys (tools/tunnel.sh keeps a host key in var/tunnel/).
RUN apk add --no-cache openssh-server \
 && test "$UID" != 0 && test "$GID" != 0 \
 && { getent group "$GID" >/dev/null || addgroup -g "$GID" eve; } \
 && adduser -D -H -h /nonexistent -s /bin/false -u "$UID" \
      -G "$(getent group "$GID" | cut -d: -f1)" eve \
 && sed -i 's/^eve:[^:]*:/eve:*:/' /etc/shadow \
 && rm -rf /etc/ssh/sshd_config /etc/ssh/sshd_config.d /etc/ssh/ssh_host_* \
 && apk list --installed 2>/dev/null | sort > /etc/eve-offline-packages.txt

USER eve
# tools/tunnel.sh passes -f with its own config; this is only a refusal if
# someone runs the image bare.
CMD ["/bin/false"]
